// automations.example.json5 — reference only. NOT auto-applied.
//
// Team-level SCHEDULING is owned by the framework (openclaw-team), NOT by any task
// provider. `install.sh` registers the scheduled jobs and each trigger dispatches,
// provider-agnostically, through the task-interface ACL:
//
//     team/automations/dispatch.mjs <job> [agent]
//
// The provider is a *callee* behind the ACL: `meerkat-taskpanel` is the DEFAULT provider
// (opt out with `./install.sh --no-meerkat-taskpanel`, then bring your own). Swap it with
// OPENCLAW_TEAM_TASK_PROVIDER; per-job entry commands live in
// team/automations/providers.json and are overridable via
// OPENCLAW_TEAM_POLL_CMD / OPENCLAW_TEAM_PATROL_CMD / OPENCLAW_TEAM_CHECKALL_CMD.
// See team/automations/README.md and team/guides/task-interface.md.
//
// Registered jobs (idempotent, by declarationKey; disable with --skip-automations):
//
//   poll-<agent>     every 5m   per built-in worker (jobs / linus / turing / assistant)
//   task-patrol      every 15m  stale in_progress heartbeat scan
//   sla-scan         every 15m  board SLA inspection (OPENCLAW_TEAM_SLA_INTERVAL)
//   team-check-all   hourly     cron "0 * * * *" @ Asia/Shanghai (gate patrol)
//   skills-update    weekly     cron "0 5 * * 0" @ Asia/Shanghai (upstream drift detect)
//   tmp-gc           daily      cron "20 2 * * *" @ Asia/Shanghai (scratch GC, `R-DISC-9`)
//
// Poll interval is configurable: OPENCLAW_TEAM_POLL_INTERVAL (default 5m, cron-slimmed
// from the former 2m/1m). Every job carries --light-context so the scheduler polls are cheap.
//
// Inspect / add by hand through the official CLI:
//   openclaw automations list --json
//   openclaw automations add --help
{
  // Reference shape only — install.sh generates the real jobs (with an absolute
  // trigger-script path). Do NOT hand-edit sqlite/store.
  // automations: [
  //   { name: "task-patrol", agentId: "main", schedule: "every 15m",
  //     target: "isolated",
  //     trigger: "<inline JS → team/automations/dispatch.mjs patrol>",
  //     prompt: "[openclaw-team] Recover stale in_progress cards (`R-BOARD-4` recovery rules)." },
  //   { name: "team-check-all", agentId: "main", schedule: "cron 0 * * * * @ Asia/Shanghai",
  //     target: "isolated",
  //     trigger: "<inline JS → team/automations/dispatch.mjs check-all>",
  //     prompt: "[openclaw-team] Gate patrol failed — handle per `R-GATE-1` / `R-ARCHIVE-1`." },
  // ],
