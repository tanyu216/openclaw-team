// model.example.json5 — EDIT ME. NOT auto-applied.
//
// Model + provider wiring is environment-specific, so this file lives under
// config/examples/ and is skipped by install.sh. Merge it by hand once you have
// a provider configured, e.g.:
//
//   openclaw config patch --file config/examples/model.example.json5
//
// Replace provider/model ids with ones your host actually has.
{
  agents: {
    defaults: {
      models: {
        "deepseek/deepseek-flash": { alias: "Flash" },
        "deepseek/deepseek-v4-pro": { alias: "Pro" },
      },
      model: {
        primary: "deepseek/deepseek-flash",
        fallbacks: ["deepseek/deepseek-v4-pro"],
      },
    },
  },
  // Provider-level optimization fields are backfilled by install.sh (§4b) via
  // config/optimization.mjs — you do NOT have to hand-edit them. Reference shape:
  //
  //   models: {
  //     providers: {
  //       deepseek: {
  //         models: [
  //           { id: "deepseek-flash", name: "DeepSeek Flash",
  //             contextTokens: 200000, cost: { cacheRead: 0.006 } },
  //           { id: "deepseek-v4-pro", name: "DeepSeek V4 Pro",
  //             contextTokens: 200000, cost: { cacheRead: 0.003625 } },
  //         ],
  //       },
  //     },
  //   },
  //
  // contextTokens=200000 is backfilled only for deepseek ids; cost.cacheRead only for
  // the whitelisted deepseek ids above. Existing values are never overwritten.
}
