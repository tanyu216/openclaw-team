# OS / runtime noise
.DS_Store
Thumbs.db
*.swp
*~

# Runtime state — never commit
team/tasks/*
!team/tasks/.gitkeep
team/workspace/*
!team/workspace/.gitkeep
team/memory/*
!team/memory/.gitkeep
team/*sessions*.json
team/*runs*.json
team/projects.json   # reference-backend (meerkat-taskpanel) runtime state; not the project registry

# Local / secrets
.env
*.local
config/local*.json5

# Lane worktrees (in-repo; see guides/dev-worktree-flow-sop.md)
# The `using-git-worktrees` skill's git fallback defaults to `.worktrees/` and
# *mandates* that the directory be ignored before creating a tree in it
# ("An unignored worktree directory commits the whole tree into the repo").
# Pre-ignoring also removes a race: several lanes starting at once would
# otherwise each edit .gitignore and commit that edit onto the shared repo root.
.worktrees/
worktrees/

# skill snapshots (generated by --vendor)
skills/vendor/

# entered during install (0600, host-local)
team/.secrets.env
