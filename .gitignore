# OS / runtime noise
.DS_Store
Thumbs.db
*.swp
*~

# Runtime state — never commit
team/tasks/*
!team/tasks/.gitkeep
team/workspace/*
!team/workspace/.gitkeep
team/memory/*
!team/memory/.gitkeep
team/*sessions*.json
team/*runs*.json
team/projects.json   # reference-backend (task-panel) runtime state; not the project registry

# Local / secrets
.env
*.local
config/local*.json5

# skill snapshots (generated by --vendor)
skills/vendor/

# entered during install (0600, host-local)
team/.secrets.env
